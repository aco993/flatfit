{
  "name": "flatfit",
  "version": "1.0.0",
  "private": true,
  "description": "Furnish an apartment in 3D with real furniture from local stores, by country. Prices, fit checks and photoreal path-traced renders in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "oidn-web": "^0.5.0",
    "three": "^0.187.0",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
